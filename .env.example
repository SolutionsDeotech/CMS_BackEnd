# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xpk0tlh.mongodb.net/deotech_cms?retryWrites=true&w=majority
# Set to true to require a valid MongoDB connection on startup
STRICT_DB=true

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# File Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=500

# External Cron Authentication Secret
CRON_SECRET=your_dedicated_cron_secret_key_here
