# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB)
# If left empty or MongoDB is unreachable, the server gracefully uses the fallback repository with preloaded seed data
MONGODB_URI=mongodb://localhost:27017/deotech_cms

# JWT Authentication Secrets
JWT_SECRET=cms_super_secret_jwt_access_key_2026_deotech
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=cms_super_secret_jwt_refresh_key_2026_deotech
JWT_REFRESH_EXPIRES_IN=30d

# File Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=500
